# Пример конфигурации бэкенда «Пахлавон». Скопируйте в .env и задайте свои значения.
# Запуск: node --experimental-sqlite server.js   (или: npm start)

# Порт HTTP-сервера
PORT=8787

# Путь к файлу базы данных SQLite (создаётся автоматически)
DB_PATH=./pahlavon.db

# Пароль входа в админ-панель — ОБЯЗАТЕЛЬНО смените на проде
ADMIN_PASSWORD=pahlavon2024

# Секрет для подписи токенов сессии — ОБЯЗАТЕЛЬНО задайте длинную случайную строку.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Разрешённый источник для CORS (домен сайта). Для теста можно "*".
# Пример: https://www.pahlavon.tj
ALLOWED_ORIGIN=*

# Время жизни токена сессии в секундах (по умолчанию 12 часов)
TOKEN_TTL=43200
